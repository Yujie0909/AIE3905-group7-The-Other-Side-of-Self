{
  "name": "the-other-side-of-self",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build && npm run cloudbase:build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "verify:providers": "node cloudbase/verify-providers.mjs",
    "test:ai": "VITE_API_BASE_URL=https://api.flow.test VITE_TENCENT_CAPTCHA_APP_ID=fixture-public-id vite build --outDir /tmp/flow-ai-browser-dist --emptyOutDir && node tests/cloudbase-browser.mjs",
    "verify:api": "node cloudbase/check-api.mjs",
    "cloudbase:build": "node cloudbase/build.mjs",
    "cloudbase:package": "npm ci --prefix cloudbase --omit=dev --ignore-scripts && node cloudbase/build.mjs --package"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.12",
    "playwright": "^1.58.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
