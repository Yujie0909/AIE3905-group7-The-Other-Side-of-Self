# Server-side console configuration ONLY. Never put these secrets in VITE_ variables.
CLOUDBASE_ENV_ID=flow-space-d9gzw4xiiba0881b3
CLOUDBASE_DB_TYPE=postgresql
# Use an existing database, a least-privilege runtime role, and TLS with CA validation.
# No sslmode query: TLS validation is enforced by the driver configuration.
DATABASE_URL=
DATABASE_CA_CERT=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
ARK_API_KEY=
ARK_BASE_URL=
ARK_IMAGE_MODEL=
ARK_IMAGE_SIZE=2048x1152
ALLOWED_ORIGINS=https://yujie0909.github.io
API_PATH_PREFIX=/flow-space-api
# Confirm which single-IP header is overwritten by the actual HTTP gateway.
CLIENT_IP_HEADER=
ABUSE_SALT=
TENCENT_CAPTCHA_APP_ID=
TENCENT_CAPTCHA_APP_SECRET_KEY=
VERIFY_DAILY_QUOTA=200
TEXT_DAILY_QUOTA=100
IMAGE_DAILY_QUOTA=20
# Tencent credentials should come from the function execution role, not browser headers.
