# Copy to .env.server.local; keep it local, chmod 600. Node reads this file, Vite never does.
# Use the actual key issuer's Base URL and exact authorized model ID. Never paste keys in chat.
API_MODE=local
API_PORT=8788
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=
ARK_API_KEY=
ARK_IMAGE_SIZE=2048x1152
TEXT_DAILY_QUOTA=30
IMAGE_DAILY_QUOTA=5
# Optional local SQLite path. Not suitable for ephemeral cloud instances.
LOCAL_DB_PATH=server/data/flow.sqlite
