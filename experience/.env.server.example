# Copy to server/.env; keep it local, chmod 600. Only the backend reads these values; never use VITE_ secret names.
# Use the actual key issuer's Base URL and exact authorized model ID. Never paste keys in chat.
API_MODE=local
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=
ARK_API_KEY=
ARK_IMAGE_SIZE=2048x1152
TEXT_DAILY_QUOTA=30
IMAGE_DAILY_QUOTA=5
